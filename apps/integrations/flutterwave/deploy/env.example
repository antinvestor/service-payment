# Flutterwave v4 integration — example environment
# Docs: https://developer.flutterwave.com/docs/getting-started

# --- Core payment service ---
PAYMENT_SERVICE_URI=127.0.0.1:7006
PAYMENT_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/payments/sa/service-payment
SETTINGS_SERVICE_URI=127.0.0.1:7010

# --- Flutterwave v4 OAuth (dashboard → Settings → API Keys → v4) ---
# Sandbox: developer sandbox portal. Live: "Switch to v4 live API keys".
FLUTTERWAVE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FLUTTERWAVE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your-dashboard-secret-hash
FLUTTERWAVE_ENVIRONMENT=sandbox
# FLUTTERWAVE_OAUTH_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
# FLUTTERWAVE_SANDBOX_API_BASE_URL=https://developersandbox-api.flutterwave.com
# FLUTTERWAVE_PRODUCTION_API_BASE_URL=https://f4bexperience.flutterwave.com

FLUTTERWAVE_DEFAULT_REDIRECT_URL=https://pay.example.com/webhook/flutterwave/return
FLUTTERWAVE_PUBLIC_WEBHOOK_BASE=https://integrations.example.com
FLUTTERWAVE_DEFAULT_COLLECTION_METHOD=bank_transfer

# --- Queues ---
QUEUE_FLUTTERWAVE_PAYMENT_NAME=flutterwave.payments.dequeue
QUEUE_FLUTTERWAVE_PAYMENT_URI=mem://flutterwave.payments.dequeue
QUEUE_FLUTTERWAVE_PROMPT_NAME=flutterwave.prompts.dequeue
QUEUE_FLUTTERWAVE_PROMPT_URI=mem://flutterwave.prompts.dequeue

FLUTTERWAVE_ENABLE_SUBSCRIPTION_WORKER=true
QUEUE_FLUTTERWAVE_SUBSCRIPTION_NAME=subscription.lifecycle
QUEUE_FLUTTERWAVE_SUBSCRIPTION_URI=mem://subscription.lifecycle
