# Yellow Card integration — example environment
# Docs: https://docs.yellowcard.engineering/

# --- Core services ---
PAYMENT_SERVICE_URI=127.0.0.1:7006
PAYMENT_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/payments/sa/service-payment
SETTINGS_SERVICE_URI=127.0.0.1:7005
SETTINGS_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/profile/sa/service-settings
SETTINGS_INTEGRATION_NAME=Yellowcard
SETTINGS_INTEGRATION_ID=Default

# --- Yellow Card credentials (Treasury Portal → API Keys) ---
YELLOWCARD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YELLOWCARD_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
YELLOWCARD_ENVIRONMENT=sandbox
# Optional: only needed when X-YC-Signature is signed with a different secret
# YELLOWCARD_WEBHOOK_SECRET=

# --- Defaults used when a payment does not say otherwise ---
# ISO 3166-1 alpha-2 country and ISO 4217 currency (derived from the MSISDN when unset)
YELLOWCARD_COUNTRY=UG
YELLOWCARD_CURRENCY=UGX
# Default mobile money network (id, code or name) when the payer does not specify one
# YELLOWCARD_NETWORK=MTN
# Force "momo" or "bank"; empty picks momo when available, else bank
# YELLOWCARD_CHANNEL_TYPE=
# retail (default) or institution
YELLOWCARD_CUSTOMER_TYPE=retail
# YELLOWCARD_BUSINESS_ID=
# YELLOWCARD_BUSINESS_NAME=
# Return URL for channels that hand the payer a payment link (South Africa EFT, Ivory Coast)
YELLOWCARD_DEFAULT_REDIRECT_URL=https://pay.example.com
YELLOWCARD_CATALOG_CACHE_SECONDS=300

# --- Queues ---
# Prompt URI must be the value registered for "yellowcard" in the payment
# service INITIATE_PROMPT_ROUTE_URIS map.
QUEUE_YELLOWCARD_PROMPT_NAME=yellowcard.prompts.dequeue
QUEUE_YELLOWCARD_PROMPT_URI=mem://yellowcard.prompts.dequeue
# Payment URI must equal the payout Route.URI configured in the payment service.
QUEUE_YELLOWCARD_PAYMENT_NAME=yellowcard.payments.dequeue
QUEUE_YELLOWCARD_PAYMENT_URI=mem://yellowcard.payments.dequeue
