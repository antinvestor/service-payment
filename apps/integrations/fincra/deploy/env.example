# Fincra integration — example environment
# Docs: https://docs.fincra.com/docs/getting-started

# --- Core services ---
PAYMENT_SERVICE_URI=127.0.0.1:7006
PAYMENT_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/payments/sa/service-payment
SETTINGS_SERVICE_URI=127.0.0.1:7005
SETTINGS_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/profile/sa/service-settings
PROFILE_SERVICE_URI=127.0.0.1:7003
PROFILE_SERVICE_WORKLOAD_API_TARGET_PATH=/ns/profile/sa/service-profile
SETTINGS_INTEGRATION_NAME=Fincra
SETTINGS_INTEGRATION_ID=Default

# --- Fincra credentials (dashboard → Settings → API keys and Webhook) ---
# Sandbox and live keys differ; webhooks are configured per environment.
FINCRA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FINCRA_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Parent business id: the "_id" returned by GET /profile/business/me
FINCRA_BUSINESS_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook encryption key; webhooks are rejected while it is unset
FINCRA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# sandbox (https://sandboxapi.fincra.com) or production (https://api.fincra.com)
FINCRA_ENVIRONMENT=sandbox

# --- Collections ---
# checkout: Fincra hosted page (card, bank transfer, mobile money; no approval needed)
# direct:   direct charge API (mobile money prompt / bank account); Fincra enables it per business
FINCRA_COLLECTION_MODE=checkout
# business: merchant pays fees, payer pays exactly the amount asked (recommended)
FINCRA_FEE_BEARER=business
# Optional: limit the hosted page's methods (card,bank_transfer,mobile_money,payattitude,opay)
# FINCRA_CHECKOUT_PAYMENT_METHODS=
FINCRA_DEFAULT_REDIRECT_URL=https://pay.example.com
# Fincra requires customer.email; used when the payer has none
# FINCRA_FALLBACK_CUSTOMER_EMAIL=payments@example.com
# Public URL of this service; direct charges send webhookUrl=<base>/webhook/fincra?tenant_id=…
FINCRA_WEBHOOK_BASE_URL=https://fincra.example.com
# Optional operator codes for mobile money direct charges, by network or currency
# FINCRA_CHARGE_OPERATORS={"MPESA":"MPESA","GHS":"MTN"}

# --- Payouts ---
# Default payout country when the payee's number names none
# FINCRA_COUNTRY=KE
# Optional mobileMoneyCode overrides by network or currency (else matched from GET /core/banks)
# FINCRA_PAYOUT_PROVIDERS={"KES":"MPESA"}
FINCRA_DEFAULT_BENEFICIARY_NAME=Mobile Money Customer
FINCRA_CATALOG_CACHE_SECONDS=600

# --- Queues ---
# Prompt URI must be the value registered for "fincra" in the payment
# service INITIATE_PROMPT_ROUTE_URIS map.
QUEUE_FINCRA_PROMPT_NAME=fincra.prompts.dequeue
QUEUE_FINCRA_PROMPT_URI=mem://fincra.prompts.dequeue
# Payment URI must be the uri of the partition's tx route in PAYMENT_ROUTES.
QUEUE_FINCRA_PAYMENT_NAME=fincra.payments.dequeue
QUEUE_FINCRA_PAYMENT_URI=mem://fincra.payments.dequeue
